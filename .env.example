# ── Supabase ─────────────────────────────────────────────────
VITE_SUPABASE_URL=https://your-project-ref.supabase.co
VITE_SUPABASE_ANON_KEY=your-anon-key-here

# ── Site URL (no trailing slash) ─────────────────────────────
# Local:      http://localhost:5173
# Production: https://your-app.netlify.app
# Used by the Google OAuth redirectTo parameter.
VITE_SITE_URL=http://localhost:5173

# ── Master admin email ────────────────────────────────────────
# The user who signs in with this email gets role=admin + portfolio plan.
# Safe to expose client-side — it only controls role assignment, not access.
VITE_MASTER_ADMIN_EMAIL=your-admin-email@example.com
